# --- Uygulama ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Panel ve terminal istekleri icin API anahtarlari (x-api-key header)
ADMIN_API_KEY=mso-admin-dev-key
TERMINAL_API_KEY=mso-terminal-dev-key
CORS_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
# npm run auth:setup ile scrypt hash oluşturulur.
ADMIN_PASSWORD_HASH=
SESSION_HOURS=12

# --- Veritabani ---
DATABASE_URL="postgresql://mso:mso_secret@localhost:5438/mso_wms?schema=public"

# --- Redis / Kuyruk ---
REDIS_URL=redis://localhost:6381
QUEUE_PREFIX=mso

# --- Sentos API ---
# Sentos panelindeki "API Url" degeri (ornek: https://<firma>.sentos.com.tr/api)
SENTOS_BASE_URL=https://msoteknoloji.sentos.com.tr/api
# Sentos panelindeki "API Anahtar" ve "API Sifre" degerleri
SENTOS_API_KEY=
SENTOS_API_SECRET=
# Sentos webhook imza dogrulama anahtari (bos ise imza kontrolu atlanir)
SENTOS_WEBHOOK_SECRET=
# Rate limit: saniyede kac istek gonderilebilir
SENTOS_RATE_LIMIT_PER_SECOND=5
# Tek istekte kac varyant gonderilecek (chunking)
SENTOS_CHUNK_SIZE=50
SENTOS_TIMEOUT_MS=20000
# true ise Sentos'a gercek istek atilmaz, sadece loglanir (guvenli deneme modu)
SENTOS_DRY_RUN=true
# Sentos limiti: POST 12/dk, ayni GET 2/dk. Stok yazimlari bu degerin altinda tutulur.
SENTOS_REQUESTS_PER_MINUTE=10
SENTOS_PAGE_SIZE=100
# Art arda okutmalar bu sure boyunca biriktirilip tek istekle Sentos'a gonderilir
SENTOS_STOCK_DEBOUNCE_MS=3000
# Fiyat aktarimi (gercek Sentos fiyat alanlarina baglanana kadar kapali)
SENTOS_PRICE_PUSH_ENABLED=false
# Ilk siparis senkronunda geriye dogru kac gunluk siparis cekilir
SENTOS_ORDER_BACKFILL_DAYS=30

# --- TCMB Kur ---
TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml

# --- CRON ---
CRON_ENABLED=true
TZ=Europe/Istanbul
CRON_FX_UPDATE=0 3 * * *
CRON_PRICE_RECALC=10 3 * * *
CRON_PRICE_PUSH=30 3 * * *
# Sentos'tan urun + stok cekme
CRON_STOCK_CHECK=*/15 * * * *
# Sentos'a iletilemeyen stok dususlerinin tekrar denenmesi
CRON_STOCK_FLUSH=* * * * *
# Sentos'tan siparis cekme (yalnizca okuma)
CRON_ORDER_SYNC=*/2 * * * *
